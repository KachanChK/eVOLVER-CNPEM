COMPOSE_PROJECT_NAME=evolver-mqtt

# O broker fica acessível apenas na máquina local nesta primeira versão.
MQTT_BIND_HOST=127.0.0.1
MQTT_PORT=1883

# Credenciais exclusivas para desenvolvimento local. Não reutilize em outro ambiente.
MQTT_HEALTH_PASSWORD=health-local-only
MQTT_INGESTION_PASSWORD=ingestion-local-only
MQTT_API_PASSWORD=api-local-only
MQTT_SIMULATOR_PASSWORD=simulator-local-only
