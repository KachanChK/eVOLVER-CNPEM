# Identidade do projeto no Docker Compose.
COMPOSE_PROJECT_NAME=evolver-cnpem

# *_BIND_HOST publica a porta pelo Docker; *_HOST será usado pelo código local.
# MQTT_PROTOCOL_VERSION será usado pelos futuros clientes; o broker não o lê.
MQTT_BIND_HOST=127.0.0.1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_PROTOCOL_VERSION=5

# Mesma separação entre endereço publicado e endereço dos futuros clientes locais.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=evolver
POSTGRES_USER=evolver
# Valor apenas para desenvolvimento local. Não reutilize em outro ambiente.
POSTGRES_PASSWORD=evolver-local-only
