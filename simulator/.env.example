# Use os mesmos host, porta e senha configurados em mqtt/.env.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_SIMULATOR_PASSWORD=simulator-local-only

# Opcional: arquivo SQLite durável para estado da bomba simulada.
# SIMULATOR_PUMP_STATE_PATH=C:/dados/evolver/pump-state.sqlite3
# Fila durável de telemetria. Por padrão, telemetry.sqlite3 ao lado do estado da bomba.
# SIMULATOR_TELEMETRY_QUEUE_PATH=C:/dados/evolver/telemetry.sqlite3
# SIMULATOR_TELEMETRY_QUEUE_MAX_EVENTS=259200

# A última lista de vials ativos confirmada pela ingestão fica na fila local.
