# Use os mesmos host, porta e senha configurados em mqtt/.env.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_SIMULATOR_PASSWORD=simulator-local-only

# Número do frasco cadastrado para evolver-sim-01 no banco.
VIAL_ID=1
# Intervalo entre as medições de OD, pH e temperatura.
SIMULATOR_INTERVAL_SECONDS=2.0

# Para vários frascos cadastrados, descomente e ajuste os números.
# SIMULATOR_VIAL_IDS=1,2,3
